{
  "name": "sgcertwatch-scheduler",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-08",
  "workers_dev": true,
  "preview_urls": false,
  // One watchdog wake-up; dispatch cadence is enforced durably inside the object.
  "triggers": { "crons": ["*/5 * * * *"] },
  "durable_objects": {
    "bindings": [{ "name": "SCHEDULER", "class_name": "SchedulerCoordinator" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SchedulerCoordinator"] }],
  "observability": {
    "logs": { "enabled": true, "invocation_logs": false, "head_sampling_rate": 1 }
  },
  "vars": {
    "GITHUB_OWNER": "hongyime",
    "GITHUB_REPO": "sgCertWatch2026",
    "GITHUB_REF": "main",
    "DISPATCH_ENABLED": "true"
  }
  // Set GITHUB_TOKEN (fine-grained PAT, this repository only, Actions: read/write)
  // and STATUS_TOKEN (random, at least 32 characters) using wrangler secret put.
  // Optional paired secrets: TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID.
  // Or private ALERT_WEBHOOK_URL (HTTPS) + optional ALERT_WEBHOOK_SECRET bearer.
  // Optional heartbeat: SUPABASE_URL + SUPABASE_PUBLISHABLE_KEY (publishable or anon).
  // Keep this worker name, binding and migration stable to preserve deduplication.
  // Validate locally: wrangler deploy --dry-run --config scheduler/wrangler.jsonc
  // Tests: node --test scheduler/tests/*.test.mjs
  // Parent supplies its repo-scoped SCHEDULER_GITHUB_TOKEN as Worker GITHUB_TOKEN.
  // Never copy an existing broad GitHub environment token into this Worker.
}
