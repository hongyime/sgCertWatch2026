  "status": "seed-unverified",

  "READ_THIS_FIRST": {
    "problem": "A WRONG allowlist entry silently suppresses a real threat. That is the most dangerous kind of error this project can make, and it fails closed with no visible symptom.",
    "rule": "Every entry below was seeded from general knowledge and is marked verified:false. Unverified entries DO suppress (otherwise the seed is useless and the feed floods on day one), but P0 launch is BLOCKED until all of them are verified. See TASKS.md M2-02b.",
    "verification": "Confirm the registrable is reachable and belongs to the named brand by navigating from the brand's official site or a published regulator listing. Do NOT verify by searching for the domain — that is how you confirm a typosquat as legitimate. Then set verified:true with the date and the source URL.",
    "ci_gate": "CI fails the release workflow while any entry has verified:false.",
    "coverage_expectation": "This seed is roughly 90 entries. Realistic full coverage is 200-600, because banks and telcos own large numbers of campaign and product domains. The list grows forever; budget for that."
  },

