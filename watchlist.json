{
  "_comment": "sgCertWatch2026 brand watchlist. See docs/DESIGN.md §4 for how these fields drive scoring, and the inclusion criteria below. Every brand needs matching allowlist entries in allowlist.json or its legitimate renewals will flood the feed.",
  "version": 1,
  "updated": "2026-08-10",
  "status": "seed",
  "inclusion_criteria": {
    "_comment": "A brand is in scope if it meets TWO of these four. 'Is it a Singapore brand' is deliberately NOT the test — the test is whether impersonating it harms people in Singapore at scale.",
    "rules": [
      "mass_market_sg: large share of SG residents hold an account or use it monthly",
      "high_value_lure: handles money, identity credentials, or delivery notifications",
      "documented_impersonation: appears in SPF/ScamShield/CSA advisories or bank security alerts",
      "sg_presence: operates a .sg domain, so lookalikes are plausible"
    ],
    "exclusions": [
      "Global brands with no SG-specific angle (Microsoft, PayPal, Netflix) — covered by every other monitor, and they would flood the feed",
      "CJK / non-Latin brand tokens — held to P1 pending confusable research, see docs/BLINDSPOTS.md",
      "Brands whose only token is a bare dictionary word with no viable context set"
    ],
    "anchors": [
      "MAS register of licensed banks (category: bank)",
      "Official government service directory (category: government)",
      "CSA and ScamShield advisories (all categories)"
    ]
  },
  "field_docs": {
    "max_edit_distance": "0 | 1 | 2. Damerau-Levenshtein budget AFTER normalisation. Homoglyphs, punycode, fullwidth and leetspeak are handled by the normalisation chain and are caught at distance 0 — this field is ONLY about typo tolerance. Short and dictionary-word tokens get 0.",
    "require_context": "If true, a brand hit only scores when a context_token also appears in the registrable. This is what makes generic tokens like 'trust' and 'mom' usable at all.",
    "context_tokens": "Curated per brand. Deliberately not the global keyword list — precision comes from these being specific.",
    "known_tlds": "Legitimate TLDs. A brand hit on any other TLD fires tld:mismatch.",
    "allow_affix": "If true, the affix decomposer may split a token into brand+keyword (e.g. 'dbsbank' -> 'dbs'+'bank'). Disable for tokens that are common substrings."
  },
