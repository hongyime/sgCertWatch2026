{
  "cleanUrls": true,
  "functions": {
    "api/findings.js": {
      "maxDuration": 10,
      "regions": ["icn1"]
    },
    "api/source-status.js": {
      "maxDuration": 10,
      "regions": ["icn1"]
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    }
  ]
}
