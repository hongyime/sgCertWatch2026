SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Secret for ct-poll endpoint (must be at least 32 characters)
CRON_SECRET=
CERTSTREAM_URL=wss://certstream.calidog.io/
CERTSTREAM_SAMPLE_MS=25000
DIRECT_CT_LOGS_PER_RUN=6
DIRECT_CT_ENTRIES_PER_LOG=128
STATIC_CT_MAX_TILES_PER_LOG=30
STATIC_CT_MAX_RUN_MS=90000
# Optional backup: at most one batch/hour, persisted backoff on provider failures
CRTSH_BATCH_SIZE=1

# GitHub Actions secrets for the scheduled intelligence workflow
ABUSECH_AUTH_KEY=
URLSCAN_API_KEY=

# Local scheduler setup only: put values in ignored .env.scheduler
# Fine-grained GitHub token scoped to this repository, Actions read/write
SCHEDULER_GITHUB_TOKEN=
# Optional operational-alert webhook; dashboard-only monitoring is the default
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
