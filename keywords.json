{
  "_comment": "Suspicious keyword tokens. These fire the kw:* signal (+10 each, capped at +25 total) and are one half of the combo:brand+kw signal. They are also the vocabulary the affix decomposer uses to split undelimited tokens like 'dbsbank' into 'dbs'+'bank'.",
  "version": 1,
  "updated": "2026-08-10",

  "scoring": {
    "per_keyword": 10,
    "cap": 25,
    "combo_with_brand": 25,
    "note": "The cap matters. Without it, 'secure-login-verify-account.sg' scores 40 on keywords alone and outranks an actual brand lookalike."
  },

  "affix_vocabulary_note": "Tokens marked affix:true are used by the affix decomposer to split undelimited strings. Keep this set SMALL and high-signal — every entry increases the chance of a spurious split. 'sg' is deliberately affix:false despite being common, because splitting on it would decompose enormous numbers of legitimate Singaporean domain names.",

  "keywords": [
    { "token": "login",        "category": "credential", "affix": true },
    { "token": "signin",       "category": "credential", "affix": true },
    { "token": "logon",        "category": "credential", "affix": true },
    { "token": "auth",         "category": "credential", "affix": true },
